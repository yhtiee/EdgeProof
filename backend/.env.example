# Copy to .env for local development. Production sets these on the host.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_ADMIN_URL=ep-console/

# Leave unset to use SQLite locally. Production: Neon pooled URL.
# DATABASE_URL=postgres://edgeproof:edgeproof@localhost:5432/edgeproof

# Field encryption: "id:fernet-key" pairs, newest first.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=k1:replace-with-a-fernet-key

SWEEP_HMAC_SECRET=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=edgeproof-uploads
AI_PROVIDER=disabled
AI_API_KEY=
SENTRY_DSN=
