# Copy to .env for local development. Production sets these on the host.
DJANGO_DEBUG=true
# Development only: open every gate (lessons in any order, exams, Strategy Lab, future features)
# so features can be tested. Ignored when DJANGO_DEBUG is false, so deployed builds are always gated.
# Set to false locally to see exactly what learners see.
OPEN_GATES=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
DJANGO_ADMIN_URL=ep-console/

# Leave unset to use SQLite locally. Production: Neon pooled URL.
# DATABASE_URL=postgres://edgeproof:edgeproof@localhost:5432/edgeproof

# Field encryption: "id:fernet-key" pairs, newest first.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=k1:replace-with-a-fernet-key

SWEEP_HMAC_SECRET=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=edgeproof-uploads
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq
GEMINI_API_KEY=
GROQ_API_KEY=
# AI_GEMINI_MODELS=gemini-3.5-flash,gemini-flash-latest
# AI_GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
AI_DAILY_USER_LIMIT=20
SENTRY_DSN=
